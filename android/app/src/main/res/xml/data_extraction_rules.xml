<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup rules. Founder decision (DECISIONS 2026-10-15): automatic backup is ON, so the
     child's progress (the WebView's localStorage lives in the app's own data) follows the parent to a
     new phone through the PARENT'S OWN Google backup. The app never sends it anywhere. The cache (which
     holds only transient export files) is never backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="." />
        <exclude domain="root" path="cache" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="." />
        <exclude domain="root" path="cache" />
    </device-transfer>
</data-extraction-rules>
